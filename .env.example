# Copy this file to .env and replace the placeholders.
RAISON_MODE=raison
RAISON_BASE_URL=https://api.ai-raison.com
RAISON_PERFORMANCE_PROJECT_ID=PRJ31575
RAISON_RECOVERY_PROJECT_ID=PRJ31625

# Use one shared key, or comment it and configure the two separate keys below.
RAISON_API_KEY=<your_raison_api_key>
# RAISON_PERFORMANCE_API_KEY=<your_performance_api_key>
# RAISON_RECOVERY_API_KEY=<your_recovery_api_key>

# Optional: add the RAISON_*_ELEMENT_* and RAISON_*_OPTION_* identifiers
# exported by your rAison projects when their IDs differ from the defaults.
